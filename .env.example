# ResQRoute Backend Environment Configuration Template
# Copy this file to .env and fill in your actual credentials.
# NEVER commit the .env file to Git!

# Supabase PostgreSQL connection string
# Format: postgresql://postgres:[YOUR-PASSWORD]@db.bydpwenvwufcxqyflxbz.supabase.co:5432/postgres
# Leave blank or commented to use local SQLite for quick offline testing.
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.bydpwenvwufcxqyflxbz.supabase.co:5432/postgres

# Django Secret Key (generate a strong random string for production)
SECRET_KEY=django-insecure-resqroute-dev-secret-key-change-in-production

# Debug Mode (set to False in production)
DEBUG=True

# Allowed Hosts (comma-separated or * for dev)
ALLOWED_HOSTS=*

# Allowed CORS Origins for Angular frontend
CORS_ALLOWED_ORIGINS=http://localhost:4200,https://resqroute.vercel.app

# OpenAI API Key for Corridor Risk Assessment Engine (Railway deployment variable)
OPENAI_API_KEY=your-openai-api-key-here
